# ==============================================================================
# AUTO-ANALYST AI ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND ENVIRONMENT VARIABLES (Configure on Railway / Render)
# ------------------------------------------------------------------------------

# Google AI Studio Gemini API Key (Required for AI agent pipeline)
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (Default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Supabase Database Configuration (Optional - falls back to local SQLite auto_analyst.db if empty)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key_here

# CORS Allowed Origins (Comma-separated list of allowed frontend origins)
# Production: https://your-app.vercel.app
# Local Dev: http://localhost:5173,http://localhost:3010
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# Server Port (Automatically assigned by Railway / Render environment)
PORT=8000


# ------------------------------------------------------------------------------
# FRONTEND ENVIRONMENT VARIABLES (Configure on Vercel Dashboard)
# ------------------------------------------------------------------------------

# Deployed Backend HTTP/HTTPS API Base URL (Do NOT include trailing slash)
# Example: https://auto-analyst-backend.up.railway.app
VITE_API_URL=https://auto-analyst-backend.up.railway.app

# Deployed Backend WS/WSS WebSocket Base URL (Optional - derived automatically from VITE_API_URL if empty)
# Example: wss://auto-analyst-backend.up.railway.app
VITE_WS_URL=wss://auto-analyst-backend.up.railway.app
